# Copy to "config" on the Kindle (same folder as this file is NOT used —
# real config lives at: /mnt/us/extensions/calendar/bin/config ).
#
# Stock Kindle wget (BusyBox 1.17) cannot do HTTPS. Pick ONE:
#
# Install curl (recommended):
#   powershell -ExecutionPolicy Bypass -File .\extensions\calendar\install-curl.ps1
#
# Or use PC LAN HTTP: schedule/serve-http.ps1 + http:// URL
# Or USB copy PNG + Mostrar (cache)

CALENDAR_URL="https://REPLACE.github.io/kindle_apps/calendar.png"

# Static curl from install-curl.ps1 (or USBNet: /mnt/us/usbnet/bin/curl)
CURL="/mnt/us/extensions/calendar/bin/curl"

# Kept for docs; ignored by ancient BusyBox wget (no --no-check-certificate).
WGET_INSECURE=1

FBINK="/mnt/us/libkh/bin/fbink"
