# Kindle config — copy to /mnt/us/extensions/calendar/bin/config
#
# Stock BusyBox wget cannot do HTTPS. Install curl with:
#   powershell -ExecutionPolicy Bypass -File .\extensions\calendar\install-curl.ps1
#
# The calendar contains personal data, so it is served from a PRIVATE repo
# through the GitHub API instead of a public URL. See SETUP.md.

# calendar.png address. Sibling views swap the filename
# (weekly.png, today.png, weather.png, month.png). Do not add a URL per view.
CALENDAR_URL="https://api.github.com/repos/OWNER/kindle_calendar_data/contents/calendar.png?ref=dist"

# Fine-grained token, read-only, limited to the data repo above.
# GitHub -> Settings -> Developer settings -> Fine-grained tokens:
#   Repository access: only kindle_calendar_data
#   Permissions: Contents = Read-only
# Leave empty when CALENDAR_URL is public (LAN http:// or Pages).
CALENDAR_TOKEN=""

# Static curl from install-curl.ps1 (or USBNet: /mnt/us/usbnet/bin/curl)
CURL="/mnt/us/extensions/calendar/bin/curl"

FBINK="/mnt/us/libkh/bin/fbink"

# Restore the UI automatically after this long, even with no exit event.
EXIT_TIMEOUT_MIN=120

# "Auto" menu entry: minutes between refreshes while the calendar is on
# screen. Each refresh wakes Wi-Fi, so keep it long.
AUTO_REFRESH_MIN=240

# Auto skips Wi-Fi downloads in this local-hour window [start, end).
# Set both to the same value to disable. Default: midnight .. 07:00.
QUIET_START_HOUR=0
QUIET_END_HOUR=7

# Must match schedule screen.png_rotate so the footer stamp aligns.
PNG_ROTATE=90

# Optional KOReader streak on the footer. Leave empty to skip (safer/faster).
# Set to the full path of statistics.sqlite3 to enable; needs sqlite3 on device.
# Example: KOREADER_STATS_DB="/mnt/us/koreader/settings/statistics.sqlite3"
KOREADER_STATS_DB=""
